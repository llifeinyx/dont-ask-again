* text=auto eol=lf
*.png binary
*.jpg binary
*.ttf binary
*.otf binary
*.bin binary
# Blender light layers and the glass UV pass are large and change with every export.
*.exr filter=lfs diff=lfs merge=lfs -text
# 3D LUTs, 3.3 MB each, rewritten by every export or bake.
assets/front/*.bin filter=lfs diff=lfs merge=lfs -text
# Full-size frames from Blender that the game's screenshots must match.
tests/reference/*.png filter=lfs diff=lfs merge=lfs -text
